src-tauri/target
src-tauri/gen
Thumbs.db

# The project's own asset folders, read by `npm run assets:sync`.
# The small curated folders are committed; the raw packs (zips, PSDs, unpacked
# archives, audio) are too large for git and stay local.
/Assets/Animations/
/Assets/SFX/
/Assets/Music/
/Assets/Loot&Equipment/
/Assets/_unpacked/
# Raw isometric floor art (very large); `npm run floors` makes the committed Assets/Floors from it.
/Assets/Tiles/

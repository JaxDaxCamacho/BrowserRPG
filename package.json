    "icons": "node scripts/make-icons.mjs",
    "floors": "node scripts/make-floors.mjs"
  },
  "dependencies": {
    "peerjs": "^1.5.5",
    "pixi.js": "^8.23.0",
    "react": "^19.0.0",

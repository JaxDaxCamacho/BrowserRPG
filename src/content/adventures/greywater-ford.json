{
  "id": "greywater-ford",
  "title": "The Toll at Greywater Ford",
  "summary": "Bandits hold the old watchtower above the river crossing and have taken the merchant guild's strongbox. Clear them out and bring it back.",
  "difficulty": "Starter",
  "debrief": "debrief",
  "ending": "return",
  "dungeons": [
    "greywater-tower"
  ],
  "dialogues": [
    {
      "id": "debrief",
      "start": "office",
      "nodes": [
        {
          "id": "office",
          "speaker": "Factor Ilse Maren",
          "image": "guild-office",
          "text": "The counting room of the Greywater Merchants' Guild smells of ink and lamp oil. Factor Ilse Maren does not look up from her ledger until the door closes.\n\n\"Three caravans in a month. All of them lost at Greywater Ford. I am told your company solves problems of this kind.\"",
          "options": [
            {
              "id": "ask-ford",
              "text": "Ask what happened at the ford.",
              "outcome": {
                "goto": "ford"
              }
            },
            {
              "id": "ask-pay",
              "text": "Ask what the job pays.",
              "outcome": {
                "goto": "pay"
              }
            }
          ]
        },
        {
          "id": "ford",
          "speaker": "Factor Ilse Maren",
          "image": "watchtower-map",
          "text": "She unrolls a stained map across the desk.\n\n\"Bandits. They have taken the old watchtower above the crossing and they toll every wagon that passes. The last caravan carried the guild strongbox. The drivers who came back say the cellars under the tower run deep.\"",
          "options": [
            {
              "id": "study-map",
              "text": "Study her map of the watchtower.",
              "check": {
                "stat": "intellect",
                "difficulty": 12,
                "by": "best"
              },
              "success": {
                "text": "There are mason's marks along the cellar passages: the lower floors were built with trapped flagstones. You will know to look for them.",
                "effects": [
                  {
                    "type": "setFlag",
                    "flag": "knowsTraps",
                    "value": true
                  }
                ],
                "goto": "pay"
              },
              "failure": {
                "text": "The map is water-stained and decades old. It tells you little you could not have guessed.",
                "goto": "pay"
              }
            },
            {
              "id": "to-pay",
              "text": "Ask what the job pays.",
              "outcome": {
                "goto": "pay"
              }
            }
          ]
        },
        {
          "id": "pay",
          "speaker": "Factor Ilse Maren",
          "image": "guild-office",
          "text": "\"One hundred gold crowns when the strongbox is back on this desk. Unopened.\"",
          "options": [
            {
              "id": "accept",
              "text": "Accept the offer.",
              "outcome": {
                "effects": [
                  {
                    "type": "setFlag",
                    "flag": "fee",
                    "value": 100
                  }
                ],
                "goto": "agreed"
              }
            },
            {
              "id": "negotiate",
              "text": "Argue that three lost caravans make this dangerous work.",
              "check": {
                "stat": "charisma",
                "difficulty": 12,
                "by": "leader"
              },
              "success": {
                "text": "She weighs you for a long moment, then dips her pen.\n\n\"One hundred and fifty. Do not make me regret it.\"",
                "effects": [
                  {
                    "type": "setFlag",
                    "flag": "fee",
                    "value": 150
                  }
                ],
                "goto": "agreed"
              },
              "failure": {
                "text": "\"The price is the price.\" Her pen does not pause.",
                "effects": [
                  {
                    "type": "setFlag",
                    "flag": "fee",
                    "value": 100
                  }
                ],
                "goto": "agreed"
              }
            },
            {
              "id": "intimidate",
              "text": "Have your Barbarian lean on the desk.",
              "requires": [
                {
                  "type": "partyHasClass",
                  "classId": "barbarian"
                }
              ],
              "check": {
                "stat": "strength",
                "difficulty": 16,
                "by": "best"
              },
              "success": {
                "text": "The desk creaks. So does her composure.\n\n\"One hundred and seventy-five. And you will leave the furniture alone.\"",
                "effects": [
                  {
                    "type": "setFlag",
                    "flag": "fee",
                    "value": 175
                  }
                ],
                "goto": "agreed"
              },
              "failure": {
                "text": "She rings a small bell. Two guild guards step into the room.\n\n\"Ninety. For the insult.\"",
                "effects": [
                  {
                    "type": "setFlag",
                    "flag": "fee",
                    "value": 90
                  }
                ],
                "goto": "agreed"
              }
            }
          ]
        },
        {
          "id": "agreed",
          "speaker": "Factor Ilse Maren",
          "image": "guild-office",
          "text": "\"Then we are agreed. Follow the river road north and you will see the tower before dusk. Bring back the strongbox, and bring it back sealed.\"",
          "options": [
            {
              "id": "set-out",
              "text": "Set out for Greywater Ford.",
              "outcome": {
                "effects": [
                  {
                    "type": "setFlag",
                    "flag": "debriefDone",
                    "value": true
                  }
                ],
                "end": "dungeon"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "event-sentry",
      "start": "challenge",
      "nodes": [
        {
          "id": "challenge",
          "speaker": "Bandit sentry",
          "image": "tower-corridor",
          "text": "A bored bandit leans on a spear in the narrow passage. He straightens when he sees you.\n\n\"Toll's paid at the ford, not in here. Who sent you?\"",
          "options": [
            {
              "id": "bribe",
              "text": "Press five silver into his hand.",
              "outcome": {
                "text": "The coins vanish. So does the sentry, down a side stair, whistling.",
                "effects": [
                  {
                    "type": "money",
                    "amount": -500
                  },
                  {
                    "type": "resolveFeature"
                  }
                ],
                "end": "dungeon"
              }
            },
            {
              "id": "bluff",
              "text": "Tell him the captain sent for fresh blades.",
              "check": {
                "stat": "charisma",
                "difficulty": 12,
                "by": "leader"
              },
              "success": {
                "text": "\"About time.\" He waves you through and wanders off toward the gate.",
                "effects": [
                  {
                    "type": "resolveFeature"
                  }
                ],
                "end": "dungeon"
              },
              "failure": {
                "text": "He shouts for help and lunges. You put him down, but the noise carries.",
                "effects": [
                  {
                    "type": "damage",
                    "amount": "1d4",
                    "target": "leader"
                  },
                  {
                    "type": "resolveFeature"
                  }
                ],
                "end": "dungeon"
              }
            },
            {
              "id": "back-off",
              "text": "Step back and think again.",
              "outcome": {
                "end": "dungeon"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "trap-tripwire",
      "start": "sprung",
      "nodes": [
        {
          "id": "sprung",
          "image": "tripwire",
          "text": "A wire snaps taut against your shin. Somewhere above, a rack of loaded crossbows swings toward the corridor.",
          "options": [
            {
              "id": "dive",
              "text": "Dive flat.",
              "check": {
                "stat": "agility",
                "difficulty": 12,
                "by": "leader"
              },
              "success": {
                "text": "Bolts hiss over your back and shatter on the stones.",
                "effects": [
                  {
                    "type": "resolveFeature"
                  }
                ],
                "end": "dungeon"
              },
              "failure": {
                "text": "Too slow. A bolt finds its mark.",
                "effects": [
                  {
                    "type": "damage",
                    "amount": "1d6",
                    "target": "roller"
                  },
                  {
                    "type": "resolveFeature"
                  }
                ],
                "end": "dungeon"
              }
            }
          ]
        },
        {
          "id": "spotted",
          "image": "tripwire",
          "text": "The tripwire glints at ankle height, running to a rack of loaded crossbows above.",
          "options": [
            {
              "id": "cut",
              "text": "Cut the wire slowly.",
              "check": {
                "stat": "agility",
                "difficulty": 10,
                "by": "best"
              },
              "success": {
                "text": "The wire parts with a soft ping. The crossbows stay still.",
                "effects": [
                  {
                    "type": "resolveFeature"
                  }
                ],
                "end": "dungeon"
              },
              "failure": {
                "text": "Your blade slips. The rack fires.",
                "effects": [
                  {
                    "type": "damage",
                    "amount": "1d4",
                    "target": "roller"
                  },
                  {
                    "type": "resolveFeature"
                  }
                ],
                "end": "dungeon"
              }
            },
            {
              "id": "step-over",
              "text": "Step over it carefully.",
              "outcome": {
                "text": "One by one you step over the wire and leave it behind, still armed.",
                "end": "dungeon"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "trap-floor",
      "start": "sprung",
      "nodes": [
        {
          "id": "sprung",
          "image": "rotten-floor",
          "text": "The boards give way with a wet crack and you drop toward the cellar below.",
          "options": [
            {
              "id": "brace",
              "text": "Brace for the fall.",
              "check": {
                "stat": "toughness",
                "difficulty": 12,
                "by": "leader"
              },
              "success": {
                "text": "You land hard but whole, and climb back up.",
                "effects": [
                  {
                    "type": "resolveFeature"
                  }
                ],
                "end": "dungeon"
              },
              "failure": {
                "text": "You land badly on the rubble.",
                "effects": [
                  {
                    "type": "damage",
                    "amount": "1d8",
                    "target": "roller"
                  },
                  {
                    "type": "resolveFeature"
                  }
                ],
                "end": "dungeon"
              }
            }
          ]
        },
        {
          "id": "spotted",
          "image": "rotten-floor",
          "text": "The floorboards here are black with rot. One wrong step and they will give way.",
          "options": [
            {
              "id": "edge",
              "text": "Edge along the wall.",
              "check": {
                "stat": "agility",
                "difficulty": 10,
                "by": "leader"
              },
              "success": {
                "text": "You cross with your back to the stones.",
                "effects": [
                  {
                    "type": "resolveFeature"
                  }
                ],
                "end": "dungeon"
              },
              "failure": {
                "text": "A board snaps and you drop to the cellar below.",
                "effects": [
                  {
                    "type": "damage",
                    "amount": "1d6",
                    "target": "roller"
                  },
                  {
                    "type": "resolveFeature"
                  }
                ],
                "end": "dungeon"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "trap-lock",
      "start": "sprung",
      "nodes": [
        {
          "id": "sprung",
          "image": "vault-door",
          "text": "Your hand closes on the iron lock and a cold voice fills your head, whispering your own death.",
          "options": [
            {
              "id": "resist",
              "text": "Hold on and force the door.",
              "check": {
                "stat": "spirit",
                "difficulty": 13,
                "by": "leader"
              },
              "success": {
                "text": "The voice breaks against your will. The lock falls open.",
                "effects": [
                  {
                    "type": "resolveFeature"
                  }
                ],
                "end": "dungeon"
              },
              "failure": {
                "text": "The curse takes its toll on everyone near the door before the lock gives.",
                "effects": [
                  {
                    "type": "damage",
                    "amount": "1d4",
                    "target": "party"
                  },
                  {
                    "type": "resolveFeature"
                  }
                ],
                "end": "dungeon"
              }
            }
          ]
        },
        {
          "id": "spotted",
          "image": "vault-door",
          "text": "Hex marks are scratched around the vault's lock. Whoever touches it will hear the curse.",
          "options": [
            {
              "id": "break-hex",
              "text": "Break the hex before touching the lock.",
              "check": {
                "stat": "spirit",
                "difficulty": 11,
                "by": "best"
              },
              "success": {
                "text": "The marks smoke and fade. The lock opens to an ordinary key.",
                "effects": [
                  {
                    "type": "resolveFeature"
                  }
                ],
                "end": "dungeon"
              },
              "failure": {
                "text": "The hex lashes back at you before it breaks.",
                "effects": [
                  {
                    "type": "damage",
                    "amount": "1d6",
                    "target": "roller"
                  },
                  {
                    "type": "resolveFeature"
                  }
                ],
                "end": "dungeon"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "event-captive",
      "start": "captive",
      "nodes": [
        {
          "id": "captive",
          "speaker": "Captive guard",
          "image": "storeroom",
          "text": "A guild guard sits chained to a beam, bruised but alive.\n\n\"You're from Maren? Get me out of these and I'll tell you what's in the hall.\"",
          "options": [
            {
              "id": "free",
              "text": "Free him.",
              "outcome": {
                "text": "\"Three of them in the hall, archers and a hedge wizard who calls down lightning. Hit the wizard first.\" He limps off toward the gate.",
                "effects": [
                  {
                    "type": "setFlag",
                    "flag": "warnedAboutHall",
                    "value": true
                  },
                  {
                    "type": "resolveFeature"
                  }
                ],
                "end": "dungeon"
              }
            },
            {
              "id": "later",
              "text": "Tell him you will be back.",
              "outcome": {
                "end": "dungeon"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "event-crate",
      "start": "crate",
      "nodes": [
        {
          "id": "crate",
          "image": "supply-crate",
          "text": "A crate stamped with the guild's mark, pried open. Most of it is gone, but two stoppered bottles are wedged in the straw.",
          "options": [
            {
              "id": "take",
              "text": "Take the bottles.",
              "outcome": {
                "text": "Two healing draughts, and under them a guild healing kit.",
                "effects": [
                  {
                    "type": "giveItem",
                    "itemId": "healing-draught",
                    "quantity": 2
                  },
                  {
                    "type": "giveItem",
                    "itemId": "healing-kit",
                    "quantity": 1
                  },
                  {
                    "type": "resolveFeature"
                  }
                ],
                "end": "dungeon"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "goal-strongbox",
      "start": "strongbox",
      "nodes": [
        {
          "id": "strongbox",
          "image": "strongbox",
          "text": "The guild strongbox sits on a stone plinth, its wax seal unbroken.",
          "options": [
            {
              "id": "take",
              "text": "Take the strongbox.",
              "outcome": {
                "text": "It is heavy, and it is yours to carry back to Factor Maren.",
                "effects": [
                  {
                    "type": "setFlag",
                    "flag": "hasStrongbox",
                    "value": true
                  },
                  {
                    "type": "resolveFeature"
                  }
                ],
                "end": "dungeon"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "return",
      "start": "office",
      "nodes": [
        {
          "id": "office",
          "speaker": "Factor Ilse Maren",
          "image": "guild-office",
          "text": "Dusk has settled over Greywater by the time you climb the guild stairs. Factor Maren is still at her ledger. Her eyes go straight to the strongbox.\n\n\"Well. It seems your company does solve problems of this kind.\"",
          "options": [
            {
              "id": "hand-over",
              "text": "Set the strongbox on her desk, seal unbroken.",
              "outcome": {
                "text": "She turns it in the lamplight, checks the wax against a stamp from her drawer, and nods once. A clerk brings a heavy purse.\n\n\"As agreed.\"",
                "effects": [
                  {
                    "type": "payFlag",
                    "flag": "fee"
                  },
                  {
                    "type": "xp",
                    "amount": 150
                  },
                  {
                    "type": "setFlag",
                    "flag": "strongboxDelivered",
                    "value": true
                  }
                ],
                "goto": "paid"
              }
            }
          ]
        },
        {
          "id": "paid",
          "speaker": "Factor Ilse Maren",
          "image": "guild-office",
          "text": "\"The river road will be open by the end of the week. The guild remembers who opened it.\"",
          "options": [
            {
              "id": "mention-guard",
              "text": "Tell her you freed one of her guards in the tower cellars.",
              "requires": [
                {
                  "type": "flag",
                  "flag": "warnedAboutHall",
                  "equals": true
                },
                {
                  "type": "flag",
                  "flag": "mentionedGuard",
                  "equals": false
                }
              ],
              "outcome": {
                "text": "For the first time, she looks up properly.\n\n\"Corporal Bren limped through the gate this morning, swearing he owed his life to sellswords. I did not believe him.\" She adds twenty crowns to the purse.",
                "effects": [
                  {
                    "type": "money",
                    "amount": 200000
                  },
                  {
                    "type": "setFlag",
                    "flag": "mentionedGuard",
                    "value": true
                  }
                ],
                "goto": "paid"
              }
            },
            {
              "id": "more-work",
              "text": "Ask if the guild has more work.",
              "requires": [
                {
                  "type": "flag",
                  "flag": "askedForWork",
                  "equals": false
                }
              ],
              "check": {
                "stat": "charisma",
                "difficulty": 13,
                "by": "leader"
              },
              "success": {
                "text": "\"Perhaps. There are always roads that need opening.\" She writes your company's name in a smaller ledger, the one she keeps in her own drawer.",
                "effects": [
                  {
                    "type": "setFlag",
                    "flag": "askedForWork",
                    "value": true
                  },
                  {
                    "type": "setFlag",
                    "flag": "guildFavour",
                    "value": true
                  }
                ],
                "goto": "paid"
              },
              "failure": {
                "text": "\"When there is, you will hear of it.\" Her pen is already moving again.",
                "effects": [
                  {
                    "type": "setFlag",
                    "flag": "askedForWork",
                    "value": true
                  }
                ],
                "goto": "paid"
              }
            },
            {
              "id": "leave",
              "text": "Take your leave.",
              "outcome": {
                "text": "You step out into the evening with heavier purses and lighter hearts. Word of the Greywater job will travel.",
                "effects": [
                  {
                    "type": "completeAdventure"
                  }
                ],
                "end": "adventureSelect"
              }
            }
          ]
        }
      ]
    }
  ]
}
